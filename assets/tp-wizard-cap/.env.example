# Copy to .env for local use and replace every placeholder with actual values.
# This file is not uploaded. Set the same variables with cf set-env for CF.
# All six variables are required; there are no runtime defaults.
VALUE_HELP_DESTINATION=<CUSTOMER_DESTINATION_NAME>
VALUE_HELP_SERVICE_PATH=<CUSTOMER_SERVICE_PATH>
VALUE_HELP_ENTITY_SET=<CUSTOMER_ENTITY_SET>
VALUE_HELP_KEY_FIELD=<CUSTOMER_CODE_PROPERTY>
VALUE_HELP_TEXT_FIELD=<CUSTOMER_DESCRIPTION_PROPERTY>
VALUE_HELP_ODATA_VERSION=<2_OR_4>

# Real SAP TP creation is the default; set FL_MOCK=true for simulation.
# This flag does NOT mock the value help.
FL_MOCK=false
# Real writes require the writable EntitySet.
# Reuses VALUE_HELP_DESTINATION and VALUE_HELP_SERVICE_PATH (OData V2).
FL_ENTITY_SET=<CUSTOMER_WRITABLE_ENTITY_SET>
AGENT_URL=http://127.0.0.1:5000/