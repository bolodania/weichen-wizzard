{
  "name": "tp-wizard-cap",
  "version": "1.0.0",
  "description": "TP-Wizard Weiche – CAP backend + React/UI5 frontend",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "cds-serve",
    "start:poc": "cds-serve --in-memory",
    "dev": "cds watch",
    "build": "cds build --production && npm run build:ui",
    "build:ui": "npm --prefix app-field ci && npm --prefix app-field run build",
    "test": "jest --forceExit"
  },
  "dependencies": {
    "@cap-js/sqlite": "^3.1.3",
    "@sap-cloud-sdk/http-client": "^3",
    "@sap/cds": "^10.2.2",
    "@sap/xssec": "4.16.0",
    "express": "^4",
    "uuid": "^9"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@types/jest": "^29",
    "axios": "^1",
    "jest": "^29",
    "supertest": "^6"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "srv/**/*.js"
    ]
  },
  "cds": {
    "valueHelp": {
      "servicePath": "/sap/opu/odata/sap/API_BUSINESS_PARTNER",
      "entitySet": "A_BusinessPartner",
      "keyField": "BusinessPartner",
      "textField": "BusinessPartnerFullName",
      "odataVersion": "2"
    },
    "requires": {
      "auth": {
        "[production]": { "kind": "xsuaa" },
        "[development]": { "kind": "mocked" }
      },
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:",
          "journal_mode": "wal"
        }
      },
      "S4H_FL": {
        "kind": "odata-v2",
        "model": "srv/external/API_FUNCTIONALLOCATION",
        "credentials": {
          "destination": "S4H_FL"
        }
      },
      "S4H_FLHIER": {
        "kind": "odata-v2",
        "model": "srv/external/FUNCNLLOCSTRUCLIST_0001",
        "credentials": {
          "destination": "S4H_FL"
        }
      }
    },
    "server": {
      "port": 4004,
      "exit_on_multi_install": false
    },
    "roots": [
      "db/",
      "srv/",
      "app/approve/"
    ],
    "fiori": {
      "preview": {
        "ui5": {
          "version": "1.120.28",
          "theme": {
            "light": "sap_horizon",
            "dark": "sap_horizon_dark",
            "switch": true
          }
        }
      }
    }
  }
}
