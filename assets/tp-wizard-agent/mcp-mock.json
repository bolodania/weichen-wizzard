{
  "servers": {
    "tp-wizard-cap": {
      "tools": {
        "createSession": {
          "description": "Erstellt eine neue Wizard-Session für die Weichenerfassung. Gibt sessionId zurück.",
          "http_endpoint": "/wizard/createSession",
          "http_method": "POST",
          "input_schema": {
            "type": "object",
            "properties": {
              "ds100": {
                "type": "string",
                "description": "DS100-Kürzel der Betriebsstelle, z.B. 'NI' oder 'FF'"
              },
              "switchNumber": {
                "type": "string",
                "description": "Weichennummer, z.B. '2006' oder '105'"
              },
              "basicForm": {
                "type": "string",
                "description": "Grundbauform-Kürzel: EWL, EWR, DKW, EKW, IBW, DW oder ABW"
              }
            },
            "required": ["ds100", "switchNumber", "basicForm"]
          }
        },
        "getSmartDefaults": {
          "description": "Liefert vorgeschlagene Standardwerte für eine Grundbauform mit Konfidenzgrad (high/medium/low). Vor dem ersten getNextQuestion aufrufen und high-confidence-Werte direkt via submitAnswer setzen.",
          "http_endpoint": "/wizard/getSmartDefaults(basicForm='{basicForm}')",
          "http_method": "GET",
          "input_schema": {
            "type": "object",
            "properties": {
              "basicForm": {
                "type": "string",
                "description": "Grundbauform-Kürzel: EWL, EWR, DKW, EKW, IBW, DW oder ABW"
              }
            },
            "required": ["basicForm"]
          }
        },
        "getNextQuestion": {
          "description": "Gibt die nächste unbeantwortete Frage für die Session zurück. Liefert null wenn alle Fragen beantwortet sind.",
          "http_endpoint": "/wizard/getNextQuestion(sessionId='{sessionId}')",
          "http_method": "GET",
          "input_schema": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "description": "Session-ID, wie von createSession zurückgegeben"
              }
            },
            "required": ["sessionId"]
          }
        },
        "submitAnswer": {
          "description": "Speichert eine Antwort auf eine Frage. source='katrin-confirmed' für Katrin-Eingaben, 'agent-default' für automatisch gesetzte Standardwerte.",
          "http_endpoint": "/wizard/submitAnswer",
          "http_method": "POST",
          "input_schema": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "description": "Session-ID"
              },
              "questionId": {
                "type": "string",
                "description": "ID der Frage, z.B. 'herzstückbauart' oder 'anzahlAntriebeZgv'"
              },
              "answer": {
                "type": "string",
                "description": "Antwort als String. Boolean: 'true'/'false'. Zahlen als Ziffernstring."
              },
              "source": {
                "type": "string",
                "description": "Herkunft der Antwort: 'katrin-confirmed', 'agent-default' oder 'katrin-correction'"
              }
            },
            "required": ["sessionId", "questionId", "answer"]
          }
        },
        "getTPPreview": {
          "description": "Gibt eine Vorschau der bisher abgeleiteten Technischen Plätze (TPs) für die Session zurück.",
          "http_endpoint": "/wizard/getTPPreview(sessionId='{sessionId}')",
          "http_method": "GET",
          "input_schema": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "description": "Session-ID"
              }
            },
            "required": ["sessionId"]
          }
        },
        "submitSession": {
          "description": "Reicht die fertig erfasste Session zur Freigabe durch Thomas (Technischer Verantwortlicher) ein. NUR diese Funktion aufrufen — NIEMALS approveSession, da nur Thomas die SAP-Schreibberechtigung hat.",
          "http_endpoint": "/wizard/submitSession",
          "http_method": "POST",
          "input_schema": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "description": "Session-ID der einzureichenden Session"
              }
            },
            "required": ["sessionId"]
          }
        },
        "bulkSubmitWithDefaults": {
          "description": "Übernimmt alle noch nicht beantworteten Fragen mit Standardwerten (source='agent-default') und reicht die Session in einem Schritt ein. Nur aufrufen wenn der Nutzer explizit alle restlichen Fragen mit Standardwerten bestätigen möchte. NIEMALS approveSession aufrufen — nur Thomas darf freigeben.",
          "http_endpoint": "/wizard/bulkSubmitWithDefaults",
          "http_method": "POST",
          "input_schema": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "description": "Session-ID"
              }
            },
            "required": ["sessionId"]
          }
        },
        "health": {
          "description": "Prüft ob der CAP-Backend-Service erreichbar ist.",
          "http_endpoint": "/wizard/health()",
          "http_method": "GET",
          "input_schema": {
            "type": "object",
            "properties": {},
            "required": []
          }
        },
        "analyseDocument": {
          "description": "Analysiert ein hochgeladenes Dokument für eine Session: prüft Pflicht-TPs, optionale TPs, fehlende Angaben und Belegstellen.",
          "http_endpoint": "/wizard/analyseDocument",
          "http_method": "POST",
          "input_schema": {
            "type": "object",
            "properties": {
              "sessionId": { "type": "string", "description": "Session-ID" },
              "filename":  { "type": "string", "description": "Dateiname des hochgeladenen Dokuments" }
            },
            "required": ["sessionId", "filename"]
          }
        },
        "editAnswer": {
          "description": "Ändert eine Antwort in einer Session (nur im Status submitted/editing). Gibt die aktualisierte TP-Vorschau zurück.",
          "http_endpoint": "/wizard/editAnswer",
          "http_method": "POST",
          "input_schema": {
            "type": "object",
            "properties": {
              "sessionId":  { "type": "string", "description": "Session-ID" },
              "questionId": { "type": "string", "description": "ID der Frage/Eingabe" },
              "answer":     { "type": "string", "description": "Neuer Wert" }
            },
            "required": ["sessionId", "questionId", "answer"]
          }
        },
        "getOpenFields": {
          "description": "Gibt alle offenen Pflichtangaben zurück, die für die TP-Ableitung fehlen.",
          "http_endpoint": "/wizard/getOpenFields(sessionId='{sessionId}')",
          "http_method": "GET",
          "input_schema": {
            "type": "object",
            "properties": {
              "sessionId": { "type": "string", "description": "Session-ID" }
            },
            "required": ["sessionId"]
          }
        }
      }
    }
  }
}
